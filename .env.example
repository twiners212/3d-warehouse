# ==============================================================================
# Database Configuration (Neon Serverless PostgreSQL)
# ==============================================================================
# Connection string for Neon Serverless PostgreSQL or local PostgreSQL instance.
# Required for running migrations and backend persistence.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# Enterprise WMS / ERP Integration (Phase 42)
# ==============================================================================
# Bearer token secret required for authenticating external WMS REST API routes
# (/api/wms/sync and /api/wms/inventory). In development, defaults to 'wms-demo-secret-key'.
WMS_API_KEY="your-wms-secret-bearer-token-here"

# ==============================================================================
# Testing & Playwright E2E Configuration (Optional)
# ==============================================================================
# BASE_URL="http://localhost:3000"
# E2E_BLUEPRINT_ID="e2e-seed-blueprint"
